{
  "name": "InfoLedgr",
  "short_name": "InfoLedgr",
  "description": "Personal income, expense and budget tracker",
  "start_url": "./index.html#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0A0F1E",
  "theme_color": "#0A0F1E",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add transaction", "short_name": "Add", "url": "./index.html#add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "./index.html#insights" }
  ]
}
